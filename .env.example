NUXT_PUBLIC_API_BASE=http://public-api.localhost
NUXT_PUBLIC_PLATFORM_BASE_DOMAIN=localhost:3000
NUXT_PUBLIC_SITE_PROTOCOL=http
NUXT_DEV_HOST=0.0.0.0
NUXT_DEV_PORT=3000
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_REVALIDATE_TOKEN=change-me
PUBLIC_API_SECRET=change-me
# Proves the X-Wt-* visitor headers to the CMS (its RENDERER_PROXY_SECRET). Secret: wrangler secret put.
NUXT_RENDERER_PROXY_SECRET=
# Cloudflare Turnstile site key for contact forms; set before the CMS's TURNSTILE_SECRET_KEY.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
