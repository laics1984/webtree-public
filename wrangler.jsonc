{
  "name": "fowable-public",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "vars": {
    "NUXT_PUBLIC_API_BASE": "https://api.fowable.com",
    "NUXT_PUBLIC_PLATFORM_BASE_DOMAIN": "public.myfowable.com",
    "NUXT_PUBLIC_SITE_PROTOCOL": "https"
  },
  // Zone-wide, because Cloudflare for SaaS custom hostnames arrive under the
  // CLIENT's domain (clientdomain.com), which no `*.public.myfowable.com/*`
  // pattern can ever match. Worker routes are evaluated against the request URL,
  // not the fallback origin, so widening this is what lets a registered custom
  // hostname reach the Worker at all.
  //
  // Safe to be this broad only because nothing else on the zone needs to be
  // served by something other than this Worker: assets moved to
  // asset.fowable.com (a different zone), and server/middleware/assetHost.ts
  // redirects anything still asking for the old host. Before adding another
  // hostname to this zone, run scripts/cloudflare/01-audit.sh.
  "routes": [
    {
      "pattern": "*/*",
      "zone_name": "myfowable.com"
    }
  ]
}
